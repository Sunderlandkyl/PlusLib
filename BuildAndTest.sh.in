#!/bin/bash

ORIGPATH=$PATH

finish()
{
  PATH=$ORIGPATH
}

buildFailed ()
{
  echo "ERROR: Build failed..."
  finish
  exit $1
}

command=$0
if [ "$1" == "-E" ] || [ "$1" == "-N" ] || [ "$1" == "-C" ] || [ "$1" == "-I" ]; then
  test_mode=$1
  shift
else
  test_mode="-E"
fi

# Held as arrays so that a value containing a space survives; the previous
# string form embedded literal quote characters into the argument itself.
test_track=()
individual_test=""
while [ "${1:-}" != "" ]; do
  case "$1" in
    "--test")
      shift
      individual_test=$1
      ;;
    "--track")
      shift
      test_track=(--track "$1")
      ;;
  esac
  shift
done

# Empty for a single-configuration generator, which picks its configuration
# at configure time.
build_config=(@PLUS_BUILD_CONFIG_ARG@)
ctest_config=(@PLUS_CTEST_CONFIG_ARG@)

case "$test_mode" in
  "-E")
    "@CMAKE_COMMAND@" --build . "${build_config[@]}" || buildFailed $?
    "@CMAKE_CTEST_COMMAND@" "${ctest_config[@]}" -D Experimental --output-on-failure "${test_track[@]}"
    ;;
  "-N")
    # Build clean first, so that every warning appears on the nightly dashboard.
    "@CMAKE_COMMAND@" --build . "${build_config[@]}" --clean-first || buildFailed $?
    "@CMAKE_CTEST_COMMAND@" "${ctest_config[@]}" -D Nightly "${test_track[@]}"
    ;;
  "-C")
    "@CMAKE_CTEST_COMMAND@" "${ctest_config[@]}" -D Continuous "${test_track[@]}"
    # Pause so that the results of the run can be read before they scroll away.
    sleep 15
    ;;
  "-I")
    # List the matching tests, then run them.
    "@CMAKE_CTEST_COMMAND@" "${ctest_config[@]}" -R "$individual_test" -N
    "@CMAKE_CTEST_COMMAND@" "${ctest_config[@]}" -R "$individual_test" -V
    ;;
esac

finish
echo "DONE"
